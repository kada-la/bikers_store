@model DashboardDto
@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="page-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="page-title mb-1">Executive Dashboard</h1>
        <p class="text-muted mb-0">High-level sales performance, inventory overview, and customer spend metrics.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="Index"
           class="btn btn-outline-secondary d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-bar-graph"></i> All Reports
        </a>
        <a asp-controller="Sales" asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle"></i> Create Sale
        </a>
    </div>
</div>

<!-- 4 KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card kpi-revenue p-3 h-100 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-uppercase fw-semibold opacity-75 fs-7">Total Revenue</span>
                    <h2 class="fw-bold mt-1 mb-0">KES @Model.TotalRevenue.ToString("N2")</h2>
                </div>
                <div class="kpi-icon bg-white bg-opacity-25 text-white">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
            </div>
            <div class="mt-3 fs-7 opacity-75">
                <i class="bi bi-check-circle"></i> Computed from persisted line-items
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card kpi-orders p-3 h-100 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-uppercase fw-semibold opacity-75 fs-7">Total Sales</span>
                    <h2 class="fw-bold mt-1 mb-0">@Model.TotalSales</h2>
                </div>
                <div class="kpi-icon bg-white bg-opacity-25 text-white">
                    <i class="bi bi-bag-check fs-3"></i>
                </div>
            </div>
            <div class="mt-3 fs-7 opacity-75">
                <i class="bi bi-arrow-up-right"></i> Completed transactions
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card kpi-products p-3 h-100 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-uppercase fw-semibold opacity-75 fs-7">Active Products</span>
                    <h2 class="fw-bold mt-1 mb-0">@Model.TotalProducts</h2>
                </div>
                <div class="kpi-icon bg-white bg-opacity-25 text-white">
                    <i class="bi bi-box-seam fs-3"></i>
                </div>
            </div>
            <div class="mt-3 fs-7 opacity-75">
                <i class="bi bi-shield-check"></i> Available in catalog
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card kpi-customers p-3 h-100 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-uppercase fw-semibold opacity-75 fs-7">Registered Customers</span>
                    <h2 class="fw-bold mt-1 mb-0">@Model.TotalCustomers</h2>
                </div>
                <div class="kpi-icon bg-white bg-opacity-25 text-white">
                    <i class="bi bi-people fs-3"></i>
                </div>
            </div>
            <div class="mt-3 fs-7 opacity-75">
                <i class="bi bi-person-check"></i> Customer database count
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-graph-up text-primary me-2"></i> Daily Sales Trend (Past 14 Days)
                </h5>
                <span class="badge bg-light text-muted border">KES Revenue</span>
            </div>
            <div class="card-body p-4">
                <canvas id="dailySalesChart" style="max-height: 280px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-pie-chart text-success me-2"></i> Category Revenue
                </h5>
                <span class="badge bg-light text-muted border">Share</span>
            </div>
            <div class="card-body p-4 d-flex align-items-center justify-content-center">
                <canvas id="categoryDonutChart" style="max-height: 260px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Sales & Top Products Tables -->
<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history text-info me-2"></i> Recent Sales
                </h5>
                <a asp-controller="Sales" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Sale #</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th class="text-center">Items</th>
                            <th class="text-end">Total (KES)</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentSales.Any())
                        {
                            @foreach (var s in Model.RecentSales)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-dark border">#@s.SaleId</span></td>
                                    <td class="fw-semibold">@s.CustomerName</td>
                                    <td class="text-muted fs-7">@s.SaleDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-center"><span
                                        class="badge bg-secondary-subtle text-secondary">@s.TotalItems</span></td>
                                        <td class="text-end fw-bold text-success">@s.TotalAmount.ToString("N2")</td>
                                        <td class="text-center">
                                            <a asp-controller="Sales" asp-action="Details" asp-route-id="@s.SaleId"
                                               class="btn btn-sm btn-light border" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No sales recorded yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title fw-bold mb-0 text-dark">
                        <i class="bi bi-star-fill text-warning me-2"></i> Top Selling Products
                    </h5>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-primary">Catalog</a>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @if (Model.TopSellingProducts.Any())
                        {
                            @foreach (var p in Model.TopSellingProducts)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                                    <div>
                                        <h6 class="mb-0 fw-semibold">@p.ProductName</h6>
                                        <small class="text-muted">@p.CategoryName &bull; @p.UnitsSold units sold</small>
                                    </div>
                                    <span class="badge bg-success-subtle text-success fs-7 fw-bold">
                                        KES @p.TotalRevenue.ToString("N2")
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">No product performance data available.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Daily Sales Line Chart
        const dailyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailySalesTrends.Select(d => d.Date.ToString("MMM dd"))));
        const dailyRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailySalesTrends.Select(d => d.TotalRevenue)));

        const dailyCtx = document.getElementById('dailySalesChart').getContext('2d');
        new Chart(dailyCtx, {
            type: 'line',
            data: {
                labels: dailyLabels.length > 0 ? dailyLabels : ['No Data'],
                datasets: [{
                    label: 'Revenue (KES)',
                    data: dailyRevenues.length > 0 ? dailyRevenues : [0],
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.08)',
                    borderWidth: 2.5,
                    fill: true,
                    tension: 0.35,
                    pointRadius: 4,
                    pointBackgroundColor: '#0d6efd'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function (value) { return 'KES ' + value.toLocaleString(); }
                        },
                        grid: { color: '#f1f5f9' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // 2. Category Donut Chart
        const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenues.Select(c => c.CategoryName)));
        const catRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenues.Select(c => c.TotalRevenue)));

        const catCtx = document.getElementById('categoryDonutChart').getContext('2d');
        new Chart(catCtx, {
            type: 'doughnut',
            data: {
                labels: catLabels.length > 0 ? catLabels : ['None'],
                datasets: [{
                    data: catRevenues.length > 0 ? catRevenues : [1],
                    backgroundColor: [
                        '#0d6efd', '#10b981', '#f59e0b', '#6366f1', '#ec4899', '#8b5cf6'
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 12, padding: 15 }
                    }
                }
            }
        });
    </script>
}
