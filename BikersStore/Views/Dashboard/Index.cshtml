@model DashboardDto
@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="page-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="page-title mb-1">Executive Dashboard</h1>
        <p class="text-muted mb-0">High-level sales performance, inventory overview, and customer spend metrics.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="Index"
           class="btn btn-outline-secondary d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-bar-graph"></i> All Reports
        </a>
        <a asp-controller="Sales" asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle"></i> Create Sale
        </a>
    </div>
</div>

<!-- 4 KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card kpi-revenue p-3 h-100 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-uppercase fw-semibold opacity-75 fs-7">Total Revenue</span>
                    <h2 class="fw-bold mt-1 mb-0">KES @Model.TotalRevenue.ToString("N2")</h2>
                </div>
                <div class="kpi-icon bg-white bg-opacity-25 text-white">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
            </div>
            <div class="mt-3 fs-7 opacity-75">
                <i class="bi bi-check-circle"></i> Computed from persisted line-items
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card kpi-orders p-3 h-100 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-uppercase fw-semibold opacity-75 fs-7">Total Sales</span>
                    <h2 class="fw-bold mt-1 mb-0">@Model.TotalSales</h2>
                </div>
                <div class="kpi-icon bg-white bg-opacity-25 text-white">
                    <i class="bi bi-bag-check fs-3"></i>
                </div>
            </div>
            <div class="mt-3 fs-7 opacity-75">
                <i class="bi bi-arrow-up-right"></i> Completed transactions
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card kpi-products p-3 h-100 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-uppercase fw-semibold opacity-75 fs-7">Active Products</span>
                    <h2 class="fw-bold mt-1 mb-0">@Model.TotalProducts</h2>
                </div>
                <div class="kpi-icon bg-white bg-opacity-25 text-white">
                    <i class="bi bi-box-seam fs-3"></i>
                </div>
            </div>
            <div class="mt-3 fs-7 opacity-75">
                <i class="bi bi-shield-check"></i> Available in catalog
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card kpi-customers p-3 h-100 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-uppercase fw-semibold opacity-75 fs-7">Registered Customers</span>
                    <h2 class="fw-bold mt-1 mb-0">@Model.TotalCustomers</h2>
                </div>
                <div class="kpi-icon bg-white bg-opacity-25 text-white">
                    <i class="bi bi-people fs-3"></i>
                </div>
            </div>
            <div class="mt-3 fs-7 opacity-75">
                <i class="bi bi-person-check"></i> Customer database count
            </div>
        </div>
    </div>
</div>
